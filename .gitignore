# Only the repo-root /data/ folder (server SQLite runtime store).
# Without the leading "/", `data/` matched ANY data directory in the
# tree — including src/client/data/, which silently dropped
# worldDetails.ts / categoryIcons.ts from every push and broke
# production builds. Keep this anchored.
/data/
