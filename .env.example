# Required in production
DB_PATH=./data/rooms.db

# Optional
NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=
ROOM_TTL_HOURS=8
LOG_LEVEL=info
MAX_ROOMS_PER_SOCKET=5
MAX_TOTAL_ROOMS=10000
# Admin Control Center (production paths must be absolute and outside release folders)
# UPLOAD_DIR=/var/lib/yallagame/uploads
# BACKUP_DIR=/var/backups/yallagame
# ANALYTICS_RETENTION_DAYS=365
# TRUST_PROXY=loopback
